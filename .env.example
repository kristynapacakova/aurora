# ─────────────────────────────────────────────────────────────────────────────
# DŮLEŽITÉ — přihlašovací proměnné níže NEMAJÍ výchozí hodnotu v kódu.
# Repozitář je veřejný na GitHubu, takže jakákoliv natvrdo napsaná výchozí
# hesla/klíče by si mohl kdokoliv přečíst a přihlásit se jimi. Bez těchto
# proměnných nastavených ve Vercelu (Project → Settings → Environment
# Variables) přihlášení na dané stránce záměrně nebude fungovat.
# ─────────────────────────────────────────────────────────────────────────────

# --- Vstup na web (dokud web není oficiálně spuštěný, celý je za kódem) ---
# Kód, který návštěvnice zadá na stránce /vstup. Vyberte si vlastní.
SITE_ACCESS_CODE=

# Tajný klíč pro podepisování session cookie vstupu na web.
# Vygenerujte si náhodný řetězec, např.: openssl rand -hex 32
SITE_COOKIE_SECRET=

# --- Administrace /admin ---
# Heslo do administrace, dokud si ho v Nastavení nezměníte na vlastní
# (to se pak uloží jako hash v databázi a má přednost před touto proměnnou).
ADMIN_PASSWORD=

# Tajný klíč pro podepisování session cookie administrace.
# Vygenerujte si náhodný řetězec, např.: openssl rand -hex 32
ADMIN_COOKIE_SECRET=

# --- Členská sekce /studium ---
# Přístupový kód pro vstup do členské sekce.
STUDIO_ACCESS_CODE=

# Tajný klíč pro podepisování session cookie členské sekce.
# Vygenerujte si náhodný řetězec, např.: openssl rand -hex 32
STUDIO_COOKIE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────

# --- Varianta A: Formspree (jednodušší, doporučeno) ---
# URL formuláře vytvořeného na https://formspree.io (např. https://formspree.io/f/abcd1234)
# Pokud necháte prázdné, použije se varianta B (Resend, /api/objednavka).
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Varianta B: Resend (odesílání e-mailů z webu) ---
# API klíč z https://resend.com
RESEND_API_KEY=
# E-mail, na který chodí nové objednávky, dotazy a upozornění
RESEND_TO_EMAIL=
# Odesílací adresa - musí být na ověřené doméně v Resendu
RESEND_FROM_EMAIL=

# --- Databáze a úložiště fotek ---
# Doplní se automaticky po připojení Postgres a Blob úložiště ve Vercelu
# (Storage → Create Database / Create → Blob). Ruční nastavení tady není
# potřeba.
